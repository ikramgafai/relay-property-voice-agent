# Local development placeholders only. Never commit real credentials or a populated .env.
APP_NAME=Relay
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+asyncpg://relay:relay_dev_only@localhost:5432/relay
CORS_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=false
# Routing is opt-in: configure BOTH for the text API and explicit --live evaluation.
# ROUTING_MODEL_BASE_URL=https://your-compatible-provider.example/v1
# ROUTING_MODEL_NAME=your-structured-output-model
# ROUTING_MODEL_API_KEY=replace-locally-never-commit
ROUTING_MODEL_TIMEOUT_SECONDS=10
ROUTING_MODEL_MAX_COMPLETION_TOKENS=1200
# Optional selection among approved non-operational response phrasings.
RESPONSE_MODEL_ENABLED=false
# Phase 8: internal/demo speech input. Never commit real credentials.
VOICE_ENABLED=false
# LIVEKIT_URL=wss://your-room-server.example
# LIVEKIT_API_KEY=replace-locally
# LIVEKIT_API_SECRET=replace-locally
# ASSEMBLYAI_API_KEY=replace-locally
STT_MODEL=universal-3-6-pro
STT_SAMPLE_RATE=16000
STT_LANGUAGE_CODES=["en"]
STT_MIN_TURN_SILENCE=128
STT_MAX_TURN_SILENCE=1280
